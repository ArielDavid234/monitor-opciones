# ── OptionsKing Analytics — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Barchart API (Open Interest) ──────────────────────────────────────────
# No API key required — uses public session-based scraping
# BARCHART_BASE_URL=https://www.barchart.com

# ── Streamlit ─────────────────────────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_THEME_BASE=dark

# ── Supabase (Auth / Login) ───────────────────────────────────────────────
# En Streamlit Cloud estas van en .streamlit/secrets.toml (sección [supabase])
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Providers ───────────────────────────────────────────────────────────────
DATA_PROVIDER=databento
DATABENTO_API_KEY=

# ── Runtime Quotas / Resilience ────────────────────────────────────────────
CHAIN_FETCH_MAX_WORKERS=6
DATABENTO_QUOTA_TOTAL_PER_MIN=240
DATABENTO_QUOTA_RESERVED_LIVE_SCANNING=160
DATABENTO_QUOTA_BACKGROUND=80
DATABENTO_QUOTA_HIGH_WATERMARK=0.85
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_TIMEOUT_SEC=90
PROVIDER_CIRCUIT_HALF_OPEN_MAX_PROBE=2

# ── Snapshot / Schema Versioning ───────────────────────────────────────────
MARKET_CACHE_VERSION=v1
MARKET_SCHEMA_VERSION=v1
SNAPSHOT_SCHEMA_VERSION=v1
SNAPSHOT_PIPELINE_ENABLED=true
SNAPSHOT_WARM_START_ENABLED=false
SNAPSHOT_WARM_START_TICKERS=SPY,QQQ,AAPL
SNAPSHOT_CHAIN_MIN_TTL_SEC=60
SNAPSHOT_CHAIN_MAX_TTL_SEC=900
CROSS_USER_DEDUPE_WINDOW_SEC=45

# ── Business Value / FinOps ───────────────────────────────────────────────
PLAN_PRICE_FREE_MONTHLY_USD=0
PLAN_PRICE_PRO_MONTHLY_USD=49
PLAN_PRICE_ENTERPRISE_MONTHLY_USD=299
COST_PROVIDER_CALL_USD=0.0025
COST_CPU_SECOND_USD=0.0008
COST_CACHE_MISS_USD=0.0004

# ── Security / Governance ──────────────────────────────────────────────────
LOG_RETENTION_DAYS=30
LOG_ANONYMIZE_USER_IDS=true
CHANGE_FREEZE_ENABLED=true
ERROR_BUDGET_MAX_ERROR_RATE_PCT_7D=2.0

# ── Future: External APIs ─────────────────────────────────────────────────
# ALPHA_VANTAGE_KEY=
# DISCORD_WEBHOOK_URL=
